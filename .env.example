# ==============================================================================
# Webhook Microservices Ecosystem - Centralized Environment Configuration
# ==============================================================================

# Database Configuration (MySQL)
MYSQL_PORT=3307
MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Accounts Service Configuration
ACCOUNTS_DB_NAME=webhook_accounts
ACCOUNTS_GRPC_HOST=accounts
ACCOUNTS_GRPC_PORT=50051

# Subscriptions Service Configuration
SUBSCRIPTIONS_DB_NAME=webhook_subscriptions
SUBSCRIPTIONS_GRPC_HOST=subscriptions
SUBSCRIPTIONS_GRPC_PORT=50052

# Webhook Runner Service Configuration
RUNNER_DB_NAME=webhook_runner
RUNNER_GRPC_HOST=webhook-runner
RUNNER_GRPC_PORT=50053

# Audit Service Configuration
AUDIT_DB_NAME=webhook_audit
AUDIT_GRPC_HOST=audit-service
AUDIT_GRPC_PORT=50054

# Request Tracker Service Configuration
REQUEST_TRACKER_DB_NAME=webhook_request_tracker
REQUEST_TRACKER_GRPC_HOST=request-tracker-service
REQUEST_TRACKER_GRPC_PORT=50055

# Apache Kafka Event Streaming Configuration
KAFKA_PORT=9092
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_WEBHOOK_DISPATCH=webhook-dispatches
KAFKA_TOPIC_WEBHOOK_RESULTS=webhook-results
KAFKA_TOPIC_AUDIT_EVENTS=audit-events
KAFKA_TOPIC_REQUEST_TRACES=http-request-traces
KAFKA_GROUP_ID=audit-service-group
KAFKA_REQUEST_TRACKER_GROUP_ID=request-tracker-group
KAFKA_ENABLED=true

# Inter-Service Authentication & Security
AUTH_TOKEN=4f7f956f34bcfa0c9a55aff6b98c4e1d87e1da6d0d33f5021b5937123d7330c1
SERVICE_TOKEN=4f7f956f34bcfa0c9a55aff6b98c4e1d87e1da6d0d33f5021b5937123d7330c1
SERVICE_NAME=api-gateway
ALLOWED_SERVICES=api-gateway,accounts,subscriptions,webhook-runner,audit-service,request-tracker-service
JWT_SECRET=api-gateway-super-secret-jwt-key-2026

# API Gateway Configuration
API_GATEWAY_PORT=8080
PORT=8080
ALLOWED_ORIGINS=*

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080/api/v1
