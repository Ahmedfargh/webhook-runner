<mxfile host="app.diagrams.net" modified="2026-09-05T23:37:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  
  <!-- ========================================================================= -->
  <!-- TAB 1: SYSTEM OVERVIEW & INTER-SERVICE COMMUNICATION MESH                 -->
  <!-- ========================================================================= -->
  <diagram id="tab_overview" name="1. System Overview &amp; Mesh">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ov_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;SYSTEM OVERVIEW: WEBHOOK &amp;amp; SUBSCRIPTION PLATFORM&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;Global Microservice Mesh, Protocol Boundaries, Cryptographic Secrets, and Database Links&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2080" height="80" as="geometry" />
        </mxCell>

        <!-- FRONTEND BOX -->
        <mxCell id="ov_fe" value="&lt;b style='font-size:15px; color:#1e40af;'&gt;CLIENT FRONTEND (Vue 3 / Vite - Port 5173)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#bfdbfe;rounded=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="600" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ov_fe_details" value="&lt;b style='color:#1e3a8a;'&gt;Key Responsibilities &amp;amp; Components:&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;Public Views:&lt;/b&gt; PlansView.vue, LoginView.vue, RegisterView.vue&lt;br/&gt;• &lt;b&gt;User Views:&lt;/b&gt; MySubscriptionView.vue, InvoicesView.vue&lt;br/&gt;• &lt;b&gt;Admin Views:&lt;/b&gt; AdminBillingView.vue, UsersView, AdminsView, RolesView&lt;br/&gt;• &lt;b&gt;Security:&lt;/b&gt; Stores JWT in localStorage, enforces router guard &amp;amp; hides admin sidebar links&lt;br/&gt;• &lt;b&gt;Axios Layer:&lt;/b&gt; Automatically injects &lt;i&gt;Authorization: Bearer &amp;lt;JWT&amp;gt;&lt;/i&gt; on every request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;align=left;spacing=8;fontSize=11;" vertex="1" parent="ov_fe">
          <mxGeometry x="20" y="45" width="560" height="350" as="geometry" />
        </mxCell>

        <!-- API GATEWAY BOX -->
        <mxCell id="ov_gw" value="&lt;b style='font-size:15px; color:#065f46;'&gt;API GATEWAY (Go / Gin - Port 8080)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;rounded=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="720" y="140" width="650" height="420" as="geometry" />
        </mxCell>
        <mxCell id="ov_gw_details" value="&lt;b style='color:#064e3b;'&gt;Key Responsibilities &amp;amp; Routing Engine:&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;Entrypoint:&lt;/b&gt; Single public entry for all frontend REST API traffic&lt;br/&gt;• &lt;b&gt;JWT Termination:&lt;/b&gt; Validates Bearer token &amp;amp; extracts userID, userEmail, userRole&lt;br/&gt;• &lt;b&gt;gRPC Translation:&lt;/b&gt; Converts incoming JSON payloads into high-speed Protobuf RPCs&lt;br/&gt;• &lt;b&gt;Service Metadata Injection:&lt;/b&gt; Injects &lt;i&gt;X-Service-Name: api-gateway&lt;/i&gt; &amp;amp; &lt;i&gt;Bearer AUTH_TOKEN&lt;/i&gt;&lt;br/&gt;• &lt;b&gt;Error Normalization:&lt;/b&gt; Maps gRPC codes (NotFound, PermissionDenied) to standard HTTP 4xx/5xx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=8;fontSize=11;" vertex="1" parent="ov_gw">
          <mxGeometry x="20" y="45" width="610" height="350" as="geometry" />
        </mxCell>

        <!-- ACCOUNTS GRPC BOX -->
        <mxCell id="ov_acc" value="&lt;b style='font-size:14px; color:#7c2d12;'&gt;ACCOUNTS SERVICE (gRPC Port 50051)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1450" y="140" width="670" height="195" as="geometry" />
        </mxCell>
        <mxCell id="ov_acc_details" value="• &lt;b&gt;User &amp;amp; Admin Modules:&lt;/b&gt; Registration, bcrypt hashing, profile lookups&lt;br/&gt;• &lt;b&gt;RBAC Engine:&lt;/b&gt; Roles, fine-grained permission tokens, country registry&lt;br/&gt;• &lt;b&gt;Database:&lt;/b&gt; MySQL &lt;i&gt;webhook_accounts&lt;/i&gt; (Pool: 200 MaxOpen, 100 MaxIdle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=8;fontSize=11;" vertex="1" parent="ov_acc">
          <mxGeometry x="20" y="35" width="630" height="140" as="geometry" />
        </mxCell>

        <!-- SUBSCRIPTIONS GRPC BOX -->
        <mxCell id="ov_sub" value="&lt;b style='font-size:14px; color:#581c87;'&gt;SUBSCRIPTIONS SERVICE (gRPC Port 50052)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1450" y="365" width="670" height="195" as="geometry" />
        </mxCell>
        <mxCell id="ov_sub_details" value="• &lt;b&gt;Plans CRUD:&lt;/b&gt; Tier pricing, webhooks quota, monthly events limit, features JSON&lt;br/&gt;• &lt;b&gt;Subscriptions Lifecycle:&lt;/b&gt; Subscribe, auto-provision free, cancel, admin override&lt;br/&gt;• &lt;b&gt;Invoicing &amp;amp; Offline Payments:&lt;/b&gt; Auto-invoicing, wire proof approval queue &amp;amp; auto-activation&lt;br/&gt;• &lt;b&gt;Database:&lt;/b&gt; MySQL &lt;i&gt;webhook_subscriptions&lt;/i&gt; (Pool: 200 MaxOpen, 100 MaxIdle)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="ov_sub">
          <mxGeometry x="20" y="35" width="630" height="140" as="geometry" />
        </mxCell>

        <!-- EDGES -->
        <mxCell id="ov_edge1" value="&lt;b&gt;HTTP REST / JSON&lt;/b&gt;&lt;br/&gt;Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2563eb;strokeWidth=2;fontColor=#1e40af;" edge="1" parent="1" source="ov_fe" target="ov_gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_edge2" value="&lt;b&gt;gRPC (Protobuf)&lt;/b&gt;&lt;br/&gt;Service Auth Headers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#9a3412;" edge="1" parent="1" source="ov_gw" target="ov_acc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ov_edge3" value="&lt;b&gt;gRPC (Protobuf)&lt;/b&gt;&lt;br/&gt;Service Auth Headers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7e22ce;strokeWidth=2;fontColor=#6b21a8;" edge="1" parent="1" source="ov_gw" target="ov_sub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SECURITY CALLOUT BANNER -->
        <mxCell id="ov_sec_box" value="&lt;b style='font-size:14px;'&gt;SECURITY &amp;amp; ZERO-TRUST BOUNDARY PRINCIPLES:&lt;/b&gt;&lt;hr/&gt;1. &lt;b&gt;End-User Isolation:&lt;/b&gt; End-users and frontend clients NEVER connect directly to gRPC ports or MySQL databases.&lt;br/&gt;2. &lt;b&gt;Caller Whitelisting:&lt;/b&gt; Both Accounts and Subscriptions gRPC services enforce an incoming &lt;i&gt;X-Service-Name&lt;/i&gt; whitelist (&lt;code&gt;ALLOWED_SERVICES=api-gateway,webhook-runner&lt;/code&gt;). Unidentified calls are rejected.&lt;br/&gt;3. &lt;b&gt;Shared Cryptographic Secret:&lt;/b&gt; Every inter-service gRPC call passes a pre-shared 256-bit &lt;i&gt;AUTH_TOKEN&lt;/i&gt; in gRPC context metadata." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;align=left;spacing=12;fontSize=11;fontColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="2080" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TAB 2: COMPLETE DATABASE ERD (ENTITY-RELATIONSHIP DIAGRAM)                -->
  <!-- ========================================================================= -->
  <diagram id="tab_erd" name="2. Complete Database ERD">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="erd_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;COMPLETE DATABASE ENTITY-RELATIONSHIP DIAGRAM (ERD)&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;MySQL Schemas: webhook_accounts (Auth &amp;amp; RBAC) and webhook_subscriptions (Billing, Plans &amp;amp; Invoicing)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2300" height="80" as="geometry" />
        </mxCell>

        <!-- SCHEMA 1: ACCOUNTS -->
        <mxCell id="erd_acc_group" value="&lt;b style='font-size:15px; color:#7c2d12;'&gt;DATABASE 1: webhook_accounts (Authentication &amp;amp; RBAC)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;rounded=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="tbl_countries" value="&lt;b&gt;countries&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(100)&lt;br/&gt;+ &lt;b&gt;country_code:&lt;/b&gt; VARCHAR(5) [INDEX]&lt;br/&gt;+ &lt;b&gt;phone_code:&lt;/b&gt; VARCHAR(10)&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="30" y="50" width="240" height="130" as="geometry" />
        </mxCell>

        <mxCell id="tbl_users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(255)&lt;br/&gt;+ &lt;b&gt;email:&lt;/b&gt; VARCHAR(191) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;phone:&lt;/b&gt; VARCHAR(50)&lt;br/&gt;+ &lt;b&gt;password:&lt;/b&gt; VARCHAR(255) [HASH]&lt;br/&gt;+ &lt;b&gt;country_id:&lt;/b&gt; UUID [FK &amp;rarr; countries.id]&lt;br/&gt;+ &lt;b&gt;created_at, updated_at, deleted_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="320" y="50" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="tbl_admins" value="&lt;b&gt;admins&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(255)&lt;br/&gt;+ &lt;b&gt;email:&lt;/b&gt; VARCHAR(191) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;phone:&lt;/b&gt; VARCHAR(50)&lt;br/&gt;+ &lt;b&gt;password:&lt;/b&gt; VARCHAR(255) [HASH]&lt;br/&gt;+ &lt;b&gt;is_super_admin:&lt;/b&gt; BOOLEAN&lt;br/&gt;+ &lt;b&gt;created_at, updated_at, deleted_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="650" y="50" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="tbl_admin_roles" value="&lt;b&gt;admin_roles (Join)&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;admin_id:&lt;/b&gt; UUID [PK, FK &amp;rarr; admins.id]&lt;br/&gt;+ &lt;b&gt;role_id:&lt;/b&gt; UUID [PK, FK &amp;rarr; roles.id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="650" y="270" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tbl_roles" value="&lt;b&gt;roles&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(100) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;description:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;is_system:&lt;/b&gt; BOOLEAN&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="320" y="270" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="tbl_role_permissions" value="&lt;b&gt;role_permissions (Join)&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;role_id:&lt;/b&gt; UUID [PK, FK &amp;rarr; roles.id]&lt;br/&gt;+ &lt;b&gt;permission_id:&lt;/b&gt; UUID [PK, FK &amp;rarr; permissions.id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#f97316;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="320" y="450" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="tbl_permissions" value="&lt;b&gt;permissions&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(100) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;resource:&lt;/b&gt; VARCHAR(50)&lt;br/&gt;+ &lt;b&gt;action:&lt;/b&gt; VARCHAR(50)&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fb923c;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_acc_group">
          <mxGeometry x="650" y="440" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- SCHEMA 2: SUBSCRIPTIONS -->
        <mxCell id="erd_sub_group" value="&lt;b style='font-size:15px; color:#581c87;'&gt;DATABASE 2: webhook_subscriptions (Plans, Subscriptions &amp;amp; Ledger)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=30;" vertex="1" parent="1">
          <mxGeometry x="1200" y="140" width="1140" height="600" as="geometry" />
        </mxCell>

        <mxCell id="tbl_plans" value="&lt;b&gt;plans&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;code:&lt;/b&gt; VARCHAR(50) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;name:&lt;/b&gt; VARCHAR(100)&lt;br/&gt;+ &lt;b&gt;description:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;price_monthly:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;price_annually:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;currency:&lt;/b&gt; VARCHAR(10)&lt;br/&gt;+ &lt;b&gt;max_webhooks:&lt;/b&gt; INT (-1=inf)&lt;br/&gt;+ &lt;b&gt;max_events_per_month:&lt;/b&gt; BIGINT&lt;br/&gt;+ &lt;b&gt;max_team_members:&lt;/b&gt; INT&lt;br/&gt;+ &lt;b&gt;features:&lt;/b&gt; JSON&lt;br/&gt;+ &lt;b&gt;is_active, is_popular:&lt;/b&gt; BOOLEAN&lt;br/&gt;+ &lt;b&gt;tier_level:&lt;/b&gt; INT&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_sub_group">
          <mxGeometry x="30" y="50" width="280" height="260" as="geometry" />
        </mxCell>

        <mxCell id="tbl_subscriptions" value="&lt;b&gt;subscriptions&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;user_id:&lt;/b&gt; UUID [INDEX]&lt;br/&gt;+ &lt;b&gt;plan_id:&lt;/b&gt; UUID [FK &amp;rarr; plans.id]&lt;br/&gt;+ &lt;b&gt;status:&lt;/b&gt; VARCHAR(50) (active, pending, canceled)&lt;br/&gt;+ &lt;b&gt;billing_cycle:&lt;/b&gt; VARCHAR(20) (monthly, annually)&lt;br/&gt;+ &lt;b&gt;current_period_start:&lt;/b&gt; DATETIME&lt;br/&gt;+ &lt;b&gt;current_period_end:&lt;/b&gt; DATETIME&lt;br/&gt;+ &lt;b&gt;cancel_at_period_end:&lt;/b&gt; BOOLEAN&lt;br/&gt;+ &lt;b&gt;custom_notes:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_sub_group">
          <mxGeometry x="370" y="50" width="320" height="220" as="geometry" />
        </mxCell>

        <mxCell id="tbl_invoices" value="&lt;b&gt;invoices&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;invoice_number:&lt;/b&gt; VARCHAR(50) [UNIQUE]&lt;br/&gt;+ &lt;b&gt;user_id:&lt;/b&gt; UUID [INDEX]&lt;br/&gt;+ &lt;b&gt;subscription_id:&lt;/b&gt; UUID [FK &amp;rarr; subscriptions.id]&lt;br/&gt;+ &lt;b&gt;amount:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;tax:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;total_amount:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;currency:&lt;/b&gt; VARCHAR(10)&lt;br/&gt;+ &lt;b&gt;status:&lt;/b&gt; VARCHAR(50) (unpaid, paid, void)&lt;br/&gt;+ &lt;b&gt;due_date:&lt;/b&gt; DATETIME&lt;br/&gt;+ &lt;b&gt;paid_at:&lt;/b&gt; DATETIME&lt;br/&gt;+ &lt;b&gt;bank_account_instructions:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_sub_group">
          <mxGeometry x="750" y="50" width="340" height="260" as="geometry" />
        </mxCell>

        <mxCell id="tbl_invoice_items" value="&lt;b&gt;invoice_items&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;invoice_id:&lt;/b&gt; UUID [FK &amp;rarr; invoices.id]&lt;br/&gt;+ &lt;b&gt;description:&lt;/b&gt; VARCHAR(255)&lt;br/&gt;+ &lt;b&gt;quantity:&lt;/b&gt; INT&lt;br/&gt;+ &lt;b&gt;unit_price:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;total:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_sub_group">
          <mxGeometry x="750" y="370" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="tbl_manual_payments" value="&lt;b&gt;manual_payment_records&lt;/b&gt;&lt;hr/&gt;+ &lt;b&gt;id:&lt;/b&gt; UUID [PK]&lt;br/&gt;+ &lt;b&gt;invoice_id:&lt;/b&gt; UUID [FK &amp;rarr; invoices.id]&lt;br/&gt;+ &lt;b&gt;user_id:&lt;/b&gt; UUID [INDEX]&lt;br/&gt;+ &lt;b&gt;amount:&lt;/b&gt; DECIMAL(10,2)&lt;br/&gt;+ &lt;b&gt;currency:&lt;/b&gt; VARCHAR(10)&lt;br/&gt;+ &lt;b&gt;transaction_reference:&lt;/b&gt; VARCHAR(100)&lt;br/&gt;+ &lt;b&gt;payer_name:&lt;/b&gt; VARCHAR(255)&lt;br/&gt;+ &lt;b&gt;payer_notes:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;status:&lt;/b&gt; VARCHAR(50) (submitted, approved, rejected)&lt;br/&gt;+ &lt;b&gt;admin_notes:&lt;/b&gt; TEXT&lt;br/&gt;+ &lt;b&gt;created_at, updated_at&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c084fc;align=left;spacing=6;fontSize=11;" vertex="1" parent="erd_sub_group">
          <mxGeometry x="370" y="320" width="320" height="240" as="geometry" />
        </mxCell>

        <!-- ERD RELATIONSHIPS -->
        <mxCell id="rel1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;" edge="1" parent="erd_acc_group" source="tbl_countries" target="tbl_users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#ea580c;strokeWidth=2;fontColor=#ea580c;" edge="1" parent="erd_acc_group" source="tbl_admins" target="tbl_admin_roles">
          <mxGeometry relative="1" as="geometry" />
