  <!-- ========================================================================= -->
  <!-- TAB 4: PACKAGE ARCHITECTURE DIAGRAM                                       -->
  <!-- ========================================================================= -->
  <diagram id="tab_package" name="4. Package Architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pkg_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;GO &amp;amp; VUE PACKAGE ARCHITECTURE &amp;amp; IMPORT HIERARCHY&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;Clean Layered Boundaries: cmd &amp;rarr; internal/handlers/controllers &amp;rarr; internal/modules &amp;rarr; internal/models &amp;rarr; pkg&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2300" height="80" as="geometry" />
        </mxCell>

        <!-- PKG 1: API GATEWAY -->
        <mxCell id="pkg_gw" value="&lt;b style='font-size:14px; color:#065f46;'&gt;Package: webhookApiGateway&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="720" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pkg_gw_content" value="&lt;b&gt;Directory &amp;amp; Package Hierarchy:&lt;/b&gt;&lt;hr/&gt;📁 &lt;b&gt;cmd/server/&lt;/b&gt; (package main) &amp;rarr; Initializes config, clients, router, starts HTTP srv&lt;br/&gt;📁 &lt;b&gt;internal/config/&lt;/b&gt; (package config) &amp;rarr; Loads .env &amp;amp; system environment&lt;br/&gt;📁 &lt;b&gt;internal/clients/&lt;/b&gt; (package clients) &amp;rarr; AccountsClient &amp;amp; SubscriptionsClient dialers&lt;br/&gt;📁 &lt;b&gt;internal/middleware/&lt;/b&gt; (package middleware) &amp;rarr; CORSMiddleware, JWTAuthMiddleware, ErrorMapper&lt;br/&gt;📁 &lt;b&gt;internal/handlers/&lt;/b&gt; (package handlers) &amp;rarr; REST controllers (auth, plan, sub, invoice, manual_payment, users, admins, roles, perms)&lt;br/&gt;📁 &lt;b&gt;api/proto/&lt;/b&gt; (generated pb.go stubs) &amp;rarr; accounts.pb.go, subscriptions.pb.go, invoice.pb.go" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=8;fontSize=11;" vertex="1" parent="pkg_gw">
          <mxGeometry x="20" y="40" width="680" height="530" as="geometry" />
        </mxCell>

        <!-- PKG 2: SUBSCRIPTIONS -->
        <mxCell id="pkg_sub" value="&lt;b style='font-size:14px; color:#581c87;'&gt;Package: subscriptions&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="750" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pkg_sub_content" value="&lt;b&gt;Directory &amp;amp; Package Hierarchy:&lt;/b&gt;&lt;hr/&gt;📁 &lt;b&gt;cmd/server/&lt;/b&gt; (package main) &amp;rarr; gRPC server bootstrap &amp;amp; dependency injection&lt;br/&gt;📁 &lt;b&gt;internal/config/&lt;/b&gt; (package config) &amp;rarr; ConnectDB, GORM pool (200/100), AutoMigrate&lt;br/&gt;📁 &lt;b&gt;internal/middleware/&lt;/b&gt; (package middleware) &amp;rarr; ServiceAuthInterceptor (whitelist &amp;amp; token check)&lt;br/&gt;📁 &lt;b&gt;internal/models/&lt;/b&gt; (package models) &amp;rarr; Plan, Subscription, Invoice, InvoiceItem, ManualPaymentRecord&lt;br/&gt;📁 &lt;b&gt;internal/modules/plan/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/subscription/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/invoice/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/manual_payment/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/pkg/apperrors/&lt;/b&gt; (Sentinel error types: ErrNotFound, ErrInvalidArgument, etc.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="pkg_sub">
          <mxGeometry x="20" y="40" width="710" height="530" as="geometry" />
        </mxCell>

        <!-- PKG 3: ACCOUNTS -->
        <mxCell id="pkg_acc" value="&lt;b style='font-size:14px; color:#7c2d12;'&gt;Package: accounts&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1590" y="140" width="750" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pkg_acc_content" value="&lt;b&gt;Directory &amp;amp; Package Hierarchy:&lt;/b&gt;&lt;hr/&gt;📁 &lt;b&gt;cmd/server/&lt;/b&gt; (package main) &amp;rarr; gRPC server bootstrap listening on 50051&lt;br/&gt;📁 &lt;b&gt;internal/config/&lt;/b&gt; (package config) &amp;rarr; ConnectDB, GORM pool (200/100), AutoMigrate&lt;br/&gt;📁 &lt;b&gt;internal/middleware/&lt;/b&gt; (package middleware) &amp;rarr; ServiceAuthInterceptor&lt;br/&gt;📁 &lt;b&gt;internal/models/&lt;/b&gt; (package models) &amp;rarr; User, Admin, Role, Permission, Country&lt;br/&gt;📁 &lt;b&gt;internal/modules/user/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/admin/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/role/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/permission/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/modules/country/&lt;/b&gt; (controller, service, repository, presenter)&lt;br/&gt;📁 &lt;b&gt;internal/helpers/phonenumbers/&lt;/b&gt; (E.164 normalization)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=8;fontSize=11;" vertex="1" parent="pkg_acc">
          <mxGeometry x="20" y="40" width="710" height="530" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TAB 5: API GATEWAY DETAILED ARCHITECTURE                                  -->
  <!-- ========================================================================= -->
  <diagram id="tab_gateway" name="5. API Gateway (Port 8080)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="gw_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;API GATEWAY SERVICE (Port 8080) - COMPONENT &amp;amp; ROUTE SPECIFICATION&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;HTTP Routing, JWT Validation, gRPC Client Adapters, and Context Injection&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#022c22;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2080" height="80" as="geometry" />
        </mxCell>

        <!-- SERVER BOOTSTRAP -->
        <mxCell id="gw_boot" value="&lt;b style='font-size:14px; color:#065f46;'&gt;1. Server Entry &amp;amp; Config (cmd/server/main.go)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="640" height="260" as="geometry" />
        </mxCell>
        <mxCell id="gw_boot_text" value="• &lt;b&gt;config.LoadConfig():&lt;/b&gt; Reads PORT (8080), JWT_SECRET, SERVICE_TOKEN, ACCOUNTS_GRPC_PORT (50051), SUBSCRIPTIONS_GRPC_PORT (50052)&lt;br/&gt;• &lt;b&gt;clients.NewAccountsClient():&lt;/b&gt; Dials localhost:50051 with gRPC keepalive &amp;amp; service auth credentials&lt;br/&gt;• &lt;b&gt;clients.NewSubscriptionsClient():&lt;/b&gt; Dials localhost:50052 with gRPC keepalive &amp;amp; service auth credentials&lt;br/&gt;• &lt;b&gt;HTTP Server Settings:&lt;/b&gt; ReadTimeout: 15s, WriteTimeout: 15s, IdleTimeout: 60s, Graceful Shutdown (SIGINT/SIGTERM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=8;fontSize=11;" vertex="1" parent="gw_boot">
          <mxGeometry x="15" y="35" width="610" height="210" as="geometry" />
        </mxCell>

        <!-- MIDDLEWARE STACK -->
        <mxCell id="gw_mid" value="&lt;b style='font-size:14px; color:#065f46;'&gt;2. Middleware Pipeline (internal/middleware/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="720" y="140" width="680" height="260" as="geometry" />
        </mxCell>
        <mxCell id="gw_mid_text" value="• &lt;b&gt;cors.go (CORSMiddleware):&lt;/b&gt; Manages Access-Control-Allow-Origin (*, localhost:5173), Methods (GET, POST, PUT, DELETE, OPTIONS), Headers (Authorization, Content-Type)&lt;br/&gt;• &lt;b&gt;jwt_auth.go (JWTAuthMiddleware):&lt;/b&gt; Parses Bearer &amp;lt;token&amp;gt;, validates HMAC-SHA256 signature, sets `userID`, `user_id`, `userEmail`, `userRole` into Gin context&lt;br/&gt;• &lt;b&gt;error_mapper.go (HandleGRPCError):&lt;/b&gt; Inspects gRPC status codes:&lt;br/&gt;  - NotFound &amp;rarr; HTTP 404 | InvalidArgument &amp;rarr; HTTP 400 | Unauthenticated &amp;rarr; HTTP 401&lt;br/&gt;  - PermissionDenied &amp;rarr; HTTP 403 | AlreadyExists &amp;rarr; HTTP 409 | Internal/Unavailable &amp;rarr; HTTP 500/503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=8;fontSize=11;" vertex="1" parent="gw_mid">
          <mxGeometry x="15" y="35" width="650" height="210" as="geometry" />
        </mxCell>

        <!-- REST ENDPOINTS DIRECTORY -->
        <mxCell id="gw_routes" value="&lt;b style='font-size:14px; color:#065f46;'&gt;3. REST Endpoints &amp;amp; Handler Mappings (internal/handlers/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#a7f3d0;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="2080" height="350" as="geometry" />
        </mxCell>
        <mxCell id="gw_r1" value="&lt;b&gt;Auth &amp;amp; Profile (auth_handler.go)&lt;/b&gt;&lt;hr/&gt;• POST /api/v1/auth/login&lt;br/&gt;• POST /api/v1/auth/register&lt;br/&gt;• GET /api/v1/auth/me (Protected)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=6;fontSize=11;" vertex="1" parent="gw_routes">
          <mxGeometry x="20" y="40" width="370" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gw_r2" value="&lt;b&gt;Plans Management (plan_handler.go)&lt;/b&gt;&lt;hr/&gt;• GET /api/v1/plans (Public)&lt;br/&gt;• GET /api/v1/plans/:id (Public)&lt;br/&gt;• POST /api/v1/admin/plans (Admin)&lt;br/&gt;• PUT /api/v1/admin/plans/:id (Admin)&lt;br/&gt;• DELETE /api/v1/admin/plans/:id (Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=6;fontSize=11;" vertex="1" parent="gw_routes">
          <mxGeometry x="410" y="40" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gw_r3" value="&lt;b&gt;Subscriptions (subscription_handler.go)&lt;/b&gt;&lt;hr/&gt;• GET /api/v1/subscriptions/current (User)&lt;br/&gt;• POST /api/v1/subscriptions/subscribe (User)&lt;br/&gt;• POST /api/v1/subscriptions/cancel (User)&lt;br/&gt;• GET /api/v1/subscriptions/admin/all (Admin)&lt;br/&gt;• POST /api/v1/subscriptions/admin/override (Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=6;fontSize=11;" vertex="1" parent="gw_routes">
          <mxGeometry x="820" y="40" width="410" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gw_r4" value="&lt;b&gt;Invoices (invoice_handler.go)&lt;/b&gt;&lt;hr/&gt;• GET /api/v1/invoices (User ledger)&lt;br/&gt;• GET /api/v1/invoices/:id (Details)&lt;br/&gt;• GET /api/v1/invoices/admin/all (Admin)&lt;br/&gt;• POST /api/v1/invoices/admin/create (Admin)&lt;br/&gt;• POST /api/v1/invoices/admin/:id/mark-paid&lt;br/&gt;• POST /api/v1/invoices/admin/:id/void" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=6;fontSize=11;" vertex="1" parent="gw_routes">
          <mxGeometry x="1250" y="40" width="390" height="120" as="geometry" />
        </mxCell>
        <mxCell id="gw_r5" value="&lt;b&gt;Offline Payments (manual_payment_handler.go)&lt;/b&gt;&lt;hr/&gt;• POST /api/v1/manual-payments (Submit Proof)&lt;br/&gt;• GET /api/v1/manual-payments/admin/all (Queue)&lt;br/&gt;• POST /api/v1/manual-payments/admin/:id/review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6ee7b7;align=left;spacing=6;fontSize=11;" vertex="1" parent="gw_routes">
          <mxGeometry x="1660" y="40" width="400" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TAB 6: SUBSCRIPTIONS & INVOICING SERVICE                                  -->
  <!-- ========================================================================= -->
  <diagram id="tab_subscriptions" name="6. Subscriptions Service (Port 50052)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sub_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;SUBSCRIPTIONS &amp;amp; INVOICING GRPC SERVICE (Port 50052) - ARCHITECTURE &amp;amp; LIFECYCLE&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;Plans CRUD, Quotas, Subscriptions State Machine, Auto-Invoicing, and Offline Wire Transfer Queue&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#2e1065;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2080" height="80" as="geometry" />
        </mxCell>

        <!-- MODULE 1: PLANS CRUD -->
        <mxCell id="sub_plan_box" value="&lt;b style='font-size:14px; color:#581c87;'&gt;1. Plan Module (internal/modules/plan/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="500" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sub_plan_text" value="• &lt;b&gt;CreatePlan / UpdatePlan:&lt;/b&gt; Validates pricing (monthly/annual), slug code uniqueness, max_webhooks (-1=unlimited), max_events_per_month, max_team_members, tier_level, is_active, is_popular.&lt;br/&gt;• &lt;b&gt;ListPlans:&lt;/b&gt; Supports `include_inactive` filter for admin console.&lt;br/&gt;• &lt;b&gt;DeletePlan:&lt;/b&gt; Soft-deletes tier from `plans` table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="sub_plan_box">
          <mxGeometry x="15" y="35" width="470" height="260" as="geometry" />
        </mxCell>

        <!-- MODULE 2: SUBSCRIPTIONS LIFECYCLE -->
        <mxCell id="sub_sub_box" value="&lt;b style='font-size:14px; color:#581c87;'&gt;2. Subscription Module (internal/modules/subscription/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="510" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sub_sub_text" value="• &lt;b&gt;Subscribe:&lt;/b&gt; If plan is Free &amp;rarr; sets status `STATUS_ACTIVE` immediately. If paid &amp;rarr; sets `STATUS_PENDING_MANUAL_PAYMENT` and invokes `invoice_service` to generate an unpaid invoice.&lt;br/&gt;• &lt;b&gt;GetUserSubscription:&lt;/b&gt; Auto-provisions free tier if no record exists yet.&lt;br/&gt;• &lt;b&gt;CancelSubscription:&lt;/b&gt; Supports `immediately=true` (cancels now) or `cancel_at_period_end=true` (remains active until renewal).&lt;br/&gt;• &lt;b&gt;AdminOverrideSubscription:&lt;/b&gt; Modifies tier, status, renewal dates, and notes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="sub_sub_box">
          <mxGeometry x="15" y="35" width="480" height="260" as="geometry" />
        </mxCell>

        <!-- MODULE 3: INVOICES -->
        <mxCell id="sub_inv_box" value="&lt;b style='font-size:14px; color:#581c87;'&gt;3. Invoice Module (internal/modules/invoice/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1090" y="140" width="500" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sub_inv_text" value="• &lt;b&gt;CreateSubscriptionInvoice:&lt;/b&gt; Computes monthly or annual rate with VAT/tax, formats unique Invoice Number (e.g. `INV-2026-0905-XXXX`), and injects bank wire IBAN/SWIFT instructions.&lt;br/&gt;• &lt;b&gt;CreateManualInvoice:&lt;/b&gt; Custom line items issued by Admin.&lt;br/&gt;• &lt;b&gt;MarkInvoicePaid:&lt;/b&gt; Sets status `STATUS_PAID` &amp;amp; transitions subscription to active.&lt;br/&gt;• &lt;b&gt;VoidInvoice:&lt;/b&gt; Marks unpaid invoice as `STATUS_VOID`." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="sub_inv_box">
          <mxGeometry x="15" y="35" width="470" height="260" as="geometry" />
        </mxCell>

        <!-- MODULE 4: MANUAL PAYMENTS -->
        <mxCell id="sub_pay_box" value="&lt;b style='font-size:14px; color:#581c87;'&gt;4. Manual Payment Module (manual_payment/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#e9d5ff;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1610" y="140" width="510" height="320" as="geometry" />
        </mxCell>
        <mxCell id="sub_pay_text" value="• &lt;b&gt;SubmitManualPayment:&lt;/b&gt; User submits bank wire reference number, payer name, and notes. Creates record with status `STATUS_SUBMITTED`.&lt;br/&gt;• &lt;b&gt;ListManualPayments:&lt;/b&gt; Admin approval queue with search &amp;amp; filter.&lt;br/&gt;• &lt;b&gt;ReviewManualPayment:&lt;/b&gt;&lt;br/&gt;  - If `approve=true` &amp;rarr; sets status `STATUS_APPROVED`, updates invoice to `PAID`, and automatically upgrades subscription to `ACTIVE`.&lt;br/&gt;  - If `approve=false` &amp;rarr; sets status `STATUS_REJECTED` with reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d8b4fe;align=left;spacing=8;fontSize=11;" vertex="1" parent="sub_pay_box">
          <mxGeometry x="15" y="35" width="480" height="260" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TAB 7: ACCOUNTS GRPC SERVICE                                              -->
  <!-- ========================================================================= -->
  <diagram id="tab_accounts" name="7. Accounts Service (Port 50051)">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="acc_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;ACCOUNTS GRPC SERVICE (Port 50051) - MODULES &amp;amp; SECURITY&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;gRPC Interceptors, Password Cryptography, Permission Matrix, and MySQL Schema&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c2d12;strokeColor=#431407;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2080" height="80" as="geometry" />
        </mxCell>

        <!-- GRPC INTERCEPTOR & AUTH -->
        <mxCell id="acc_interceptor" value="&lt;b style='font-size:14px; color:#7c2d12;'&gt;1. Security Interceptor (internal/middleware/service_auth.go)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="660" height="280" as="geometry" />
        </mxCell>
        <mxCell id="acc_interceptor_text" value="• &lt;b&gt;UnaryServerInterceptor:&lt;/b&gt; Intercepts all incoming gRPC method calls before reaching controllers.&lt;br/&gt;• &lt;b&gt;Header Checks:&lt;/b&gt;&lt;br/&gt;  1. Reads `X-Service-Name` from metadata. Matches against `ALLOWED_SERVICES` (&lt;i&gt;api-gateway,webhook-runner&lt;/i&gt;). If absent or unknown &amp;rarr; &lt;b&gt;codes.PermissionDenied&lt;/b&gt;.&lt;br/&gt;  2. Reads `Authorization: Bearer &amp;lt;AUTH_TOKEN&amp;gt;`. Compares against environment secret. If mismatch &amp;rarr; &lt;b&gt;codes.Unauthenticated&lt;/b&gt;.&lt;br/&gt;• Ensures that direct rogue network calls cannot execute user operations or queries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=8;fontSize=11;" vertex="1" parent="acc_interceptor">
          <mxGeometry x="15" y="35" width="630" height="230" as="geometry" />
        </mxCell>

        <!-- MODULES BREAKDOWN -->
        <mxCell id="acc_mods" value="&lt;b style='font-size:14px; color:#7c2d12;'&gt;2. Internal Domain Modules (internal/modules/)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fed7aa;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="740" y="140" width="1380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="acc_m1" value="&lt;b&gt;user/ Module&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;controller:&lt;/b&gt; Implements UserServer gRPC&lt;br/&gt;• &lt;b&gt;service:&lt;/b&gt; Hashes password with bcrypt.GenerateFromPassword (Cost: 10)&lt;br/&gt;• &lt;b&gt;repository:&lt;/b&gt; GORM CRUD operations on `users` table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=6;fontSize=11;" vertex="1" parent="acc_mods">
          <mxGeometry x="20" y="40" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="acc_m2" value="&lt;b&gt;admin/ Module&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;controller:&lt;/b&gt; Implements AdminServer gRPC&lt;br/&gt;• &lt;b&gt;service:&lt;/b&gt; Handles admin provisioning &amp;amp; AssignRoles / AssignPermissions&lt;br/&gt;• &lt;b&gt;repository:&lt;/b&gt; Joins with `admin_roles` and `permissions`" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=6;fontSize=11;" vertex="1" parent="acc_mods">
          <mxGeometry x="350" y="40" width="310" height="220" as="geometry" />
        </mxCell>
        <mxCell id="acc_m3" value="&lt;b&gt;role/ &amp;amp; permission/ Modules&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;role:&lt;/b&gt; Defines standard &amp;amp; custom roles (e.g. administrator, support_agent)&lt;br/&gt;• &lt;b&gt;permission:&lt;/b&gt; Defines atomic capabilities (users.read, plans.create)&lt;br/&gt;• &lt;b&gt;matrix:&lt;/b&gt; Updates `role_permissions` join table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=6;fontSize=11;" vertex="1" parent="acc_mods">
          <mxGeometry x="680" y="40" width="330" height="220" as="geometry" />
        </mxCell>
        <mxCell id="acc_m4" value="&lt;b&gt;country/ Module&lt;/b&gt;&lt;hr/&gt;• &lt;b&gt;controller:&lt;/b&gt; CountryServer gRPC&lt;br/&gt;• &lt;b&gt;service:&lt;/b&gt; Lists ISO countries, phone dial codes (+1, +20, +966)&lt;br/&gt;• &lt;b&gt;repository:&lt;/b&gt; Queries `countries` table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fdba74;align=left;spacing=6;fontSize=11;" vertex="1" parent="acc_mods">
          <mxGeometry x="1030" y="40" width="330" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================================================= -->
  <!-- TAB 8: VUE 3 FRONTEND & RBAC NAVIGATION ARCHITECTURE                      -->
  <!-- ========================================================================= -->
  <diagram id="tab_frontend" name="8. Vue 3 Frontend &amp; RBAC">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fe_title" value="&lt;b style='font-size:22px; color:#ffffff;'&gt;VUE 3 FRONTEND ARCHITECTURE - VIEWS, STORES, ROUTER GUARDS &amp;amp; RBAC&lt;/b&gt;&lt;br/&gt;&lt;span style='font-size:12px; color:#94a3b8;'&gt;Role Separation (User vs. Admin), State Management, Axios Interceptors, and Multi-Language Localization&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e40af;strokeColor=#172554;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2080" height="80" as="geometry" />
        </mxCell>

        <!-- ROLE COMPARISON: USER VS ADMIN -->
        <mxCell id="fe_role_user" value="&lt;b style='font-size:14px; color:#0369a1;'&gt;USER ROLE CAPABILITIES (role: &quot;user&quot;)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="fe_role_user_text" value="• &lt;b&gt;Visible Navigation Menu:&lt;/b&gt; Dashboard, Plans &amp;amp; Pricing, My Subscription, Invoices &amp;amp; Ledger.&lt;br/&gt;• &lt;b&gt;Plans &amp;amp; Pricing (/plans):&lt;/b&gt; Browse available subscription tiers, toggle monthly/annual discounts, and click to order.&lt;br/&gt;• &lt;b&gt;My Subscription (/subscription):&lt;/b&gt; View active plan name, renewal date, quota consumption bars, offline wire credentials, and cancel/unsubscribe.&lt;br/&gt;• &lt;b&gt;Invoices (/invoices):&lt;/b&gt; View personal billing ledger, open printable invoices, and submit bank transfer wire reference numbers.&lt;br/&gt;• &lt;b&gt;Restricted:&lt;/b&gt; Cannot see or access Admin Console, Admins, Users, Roles, Permissions, or Topology." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7dd3fc;align=left;spacing=8;fontSize=11;" vertex="1" parent="fe_role_user">
          <mxGeometry x="15" y="35" width="990" height="230" as="geometry" />
        </mxCell>

        <mxCell id="fe_role_admin" value="&lt;b style='font-size:14px; color:#b91c1c;'&gt;ADMIN ROLE CAPABILITIES (role: &quot;admin&quot;)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fecaca;rounded=1;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="1100" y="140" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="fe_role_admin_text" value="• &lt;b&gt;Full Core Modules:&lt;/b&gt; User Management (/users), Admin Accounts (/admins), Roles &amp;amp; Matrix (/roles), Permissions (/permissions).&lt;br/&gt;• &lt;b&gt;Admin Billing Console (/admin/billing):&lt;/b&gt;&lt;br/&gt;  - &lt;i&gt;Offline Payment Queue:&lt;/i&gt; Review submitted bank transfers, approve (auto-activates subscription), or reject.&lt;br/&gt;  - &lt;i&gt;All Invoices:&lt;/i&gt; Create manual custom invoices, mark paid, void invoices.&lt;br/&gt;  - &lt;i&gt;All Subscriptions:&lt;/i&gt; List all accounts &amp;amp; perform admin overrides on tiers, status, and renewal dates.&lt;br/&gt;  - &lt;i&gt;Plans Management (CRUD):&lt;/i&gt; Create new plans, edit pricing/quotas/features, toggle popular/active status, delete plans.&lt;br/&gt;• &lt;b&gt;System Security:&lt;/b&gt; System Topology (/topology) visualizer and live microservices ping." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fca5a5;align=left;spacing=8;fontSize=11;" vertex="1" parent="fe_role_admin">
          <mxGeometry x="15" y="35" width="990" height="230" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

</mxfile>
